    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@types/react-simple-maps": "^3.0.6",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "^5.9.2",
